# Copy to .env. Everything works without keys (demo planner, Postgres warehouse).

# Planner: demo (rule-based, no key) or openrouter
PLANNER=demo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Warehouse: postgres (default) or bigquery
WAREHOUSE=postgres
BIGQUERY_PROJECT=
# Path to a service account JSON file, mounted read-only into the api container
GOOGLE_APPLICATION_CREDENTIALS=

# Queries estimated at or above this many bytes need a click to approve (100 MiB)
APPROVAL_BYTES=104857600
